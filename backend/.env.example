# ============================================================
# DataOff Backend — Variables de Entorno
# Copia este archivo como .env y ajusta los valores
# ============================================================

# Aplicación
APP_NAME="DataOff API"
APP_VERSION="1.0.0"
DEBUG=True
ENVIRONMENT=development

# Servidor
HOST=0.0.0.0
PORT=8000

# Base de datos PostgreSQL
DATABASE_URL=postgresql://dataoff_user:dataoff_password@localhost:5432/dataoff_db
# Para async (asyncpg):
ASYNC_DATABASE_URL=postgresql+asyncpg://dataoff_user:dataoff_password@localhost:5432/dataoff_db

# JWT
SECRET_KEY=CHANGE_THIS_TO_A_VERY_LONG_RANDOM_SECRET_KEY_IN_PRODUCTION
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS — Orígenes permitidos (separados por coma)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# Seguridad
BCRYPT_ROUNDS=12

# Primer superusuario (se crea automáticamente al iniciar)
FIRST_SUPERUSER_EMAIL=admin@dataoff.com
FIRST_SUPERUSER_PASSWORD=Admin@DataOff2024
FIRST_SUPERUSER_NAME=Administrador
