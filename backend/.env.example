# ============================================================
# DataOff Backend — Variables de Entorno (Dokploy / Producción)
# Copia estas variables a la pestaña 'Environment' en Dokploy
# ============================================================

# Aplicación
APP_NAME="DataOff API"
APP_VERSION="1.0.0"
DEBUG=False
ENVIRONMENT=production

# Servidor
HOST=0.0.0.0
PORT=8000
UVICORN_WORKERS=2
LOG_LEVEL=info

# Base de datos PostgreSQL
# Si usas el servicio PostgreSQL de Dokploy en el mismo proyecto:
# DATABASE_URL=postgresql://<usuario>:<password>@<nombre_servicio_postgres>:5432/<nombre_db>
DATABASE_URL=postgresql://dataoff_user:dataoff_password@localhost:5432/dataoff_db

# Opcional (si se requiere cliente asíncrono):
# ASYNC_DATABASE_URL=postgresql+asyncpg://dataoff_user:dataoff_password@localhost:5432/dataoff_db

# JWT (Generar clave segura con: openssl rand -hex 32)
SECRET_KEY=CHANGE_THIS_TO_A_VERY_LONG_RANDOM_SECRET_KEY_IN_PRODUCTION
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS — Orígenes permitidos (separados por coma, sin barra final '/')
# Coloca aquí la URL donde esté alojado tu frontend web / panel de administración
ALLOWED_ORIGINS=https://app.tudominio.com,https://tudominio.com

# Seguridad
BCRYPT_ROUNDS=12

# Primer superusuario (se crea automáticamente en el primer despliegue)
FIRST_SUPERUSER_EMAIL=admin@dataoff.com
FIRST_SUPERUSER_PASSWORD=Admin@DataOff2024Secure
FIRST_SUPERUSER_NAME=Administrador
